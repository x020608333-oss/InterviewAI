# ==== LLM 配置（OpenAI 兼容协议）====
# 不配置 OPENAI_API_KEY 时，系统自动进入“离线演示模式”，
# 由内置规则引擎驱动面试流程，无需联网即可完整体验。
# 配置后自动切换为真实大模型（RAG + Agent + Function Calling 全链路）。

# 智谱 BigModel（默认，glm-4-flash 免费）：https://open.bigmodel.cn
OPENAI_API_KEY=
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
LLM_MODEL=glm-4-flash

# OpenAI 官方示例：
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# DeepSeek 示例：
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# ==== 面试策略参数 ====
# 每道题最多追问次数
MAX_FOLLOWUPS=2
# 每个技能考察点抽取的题目数
QUESTIONS_PER_SKILL=2
# 单场面试总题数上限
TOTAL_QUESTIONS=7

# ==== 认证 ====
SECRET_KEY=interviewai-dev-secret-change-me
TOKEN_EXPIRE_HOURS=72
